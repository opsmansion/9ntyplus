---
import { RiArrowDownSLine, RiCloseLine, RiMenuLine, RiMoonLine, RiSunLine } from "@remixicon/react";
import { buttonVariants } from "./ui/button";
import { earlyAccess, links, navigation, product, talkToSales } from "../lib/site";
---

<div class="topbar">
  <p class="shell flex min-h-10 flex-wrap items-center justify-center gap-x-3 gap-y-1 py-2 text-center text-sm">
    <span>{product.name} is the first product from {product.maker}.</span>
    <a href={talkToSales("promo-bar")}>Talk to sales</a>
  </p>
</div>

<header class="site-header">
  <div class="shell flex h-16 items-center justify-between gap-4 site-nav:h-[4.5rem]">
    <a href="/" class="brand" aria-label={`${product.name} home`}>
      <span class="font-heading text-[1.9rem] leading-none font-extrabold tracking-tight">90<span class="text-[var(--primary-strong)]">+</span></span>
      <span class="brand-by">by {product.maker}</span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-1 site-nav:flex">
      {navigation.map((menu) => (
        <details class="nav-menu" data-nav-menu>
          <summary class="nav-trigger">
            {menu.label}
            <RiArrowDownSLine aria-hidden="true" className="nav-chevron size-4" />
          </summary>
          <div class="nav-panel">
            {menu.items.map((item) => (
              <a href={item.href}>
                <strong>{item.label}</strong>
                {item.description && <span>{item.description}</span>}
              </a>
            ))}
          </div>
        </details>
      ))}
      <a href={talkToSales("pricing")} class="nav-link">Pricing</a>
    </nav>

    <div class="flex items-center gap-1.5">
      <button type="button" data-theme-toggle class="motion-press grid size-10 place-items-center rounded-full text-[var(--heading)] hover:bg-muted focus-visible:outline-2 focus-visible:outline-ring" aria-label="Switch color theme">
        <RiMoonLine aria-hidden="true" className="size-5 dark:hidden" />
        <RiSunLine aria-hidden="true" className="hidden size-5 dark:block" />
      </button>
      <a href={talkToSales("header")} class="nav-link hidden sm:flex">Talk to sales</a>
      <a href={earlyAccess("header")} class={buttonVariants({ size: "lg", className: "hidden min-h-10 rounded-full px-5 font-semibold sm:inline-flex" })}>Early Access</a>
      <details class="site-nav:hidden" data-mobile-menu>
        <summary aria-label="Menu" class="grid size-10 cursor-pointer list-none place-items-center rounded-full text-[var(--heading)] hover:bg-muted [&::-webkit-details-marker]:hidden">
          <RiMenuLine aria-hidden="true" className="size-6 [details[open]_&]:hidden" />
          <RiCloseLine aria-hidden="true" className="hidden size-6 [details[open]_&]:block" />
        </summary>
        <nav aria-label="Mobile" class="mobile-panel">
          {navigation.map((menu) => (
            <div class="border-b border-border py-4">
              <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-muted-foreground">{menu.label}</p>
              <ul class="grid gap-1">
                {menu.items.map((item) => <li><a href={item.href} class="block rounded-lg py-2 text-base font-medium text-[var(--heading)]">{item.label}</a></li>)}
              </ul>
            </div>
          ))}
          <div class="grid gap-2 pt-5">
            <a href={earlyAccess("mobile-menu")} class={buttonVariants({ size: "lg", className: "min-h-11 w-full rounded-full font-semibold" })}>Early Access</a>
            <a href={talkToSales("mobile-menu")} class={buttonVariants({ variant: "outline", size: "lg", className: "min-h-11 w-full rounded-full" })}>Talk to sales</a>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // One desktop menu open at a time; close on outside click, Escape, or choosing a link.
  const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-nav-menu], [data-mobile-menu]"));
  menus.forEach((menu) => {
    menu.addEventListener("toggle", () => {
      if (menu.open) menus.forEach((other) => other !== menu && (other.open = false));
    });
    menu.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) menu.open = false;
    });
    menu.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
  });
  document.addEventListener("pointerdown", (event) => {
    menus.forEach((menu) => menu.open && !menu.contains(event.target as Node) && (menu.open = false));
  });
  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const next = document.documentElement.classList.contains("dark") ? "light" : "dark";
    window.dispatchEvent(new CustomEvent("opesi:theme-change", { detail: next }));
  });
</script>
